<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://jetbrains.org/compose/ComposeTizenDemo"
        version="1.0.0"
        viewmodes="maximized">
    <tizen:application id="ComposeTiz.ComposeTizenDemo"
                       package="ComposeTiz"
                       required_version="6.0"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Compose Tizen TV Demo</name>
    <tizen:profile name="tv-samsung"/>

    <!-- Required before tizen.tvinputdevice.registerKeyBatch() may claim the remote's
         TV-specific buttons. -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

    <!-- hwkey-event="enable" delivers the remote's hardware keys to the page instead of letting
         the TV act on them. context-menu and screen-orientation keep the shell out of the way. -->
    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
</widget>
